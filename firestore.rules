rules_version = '2';

// ============================================================
// Firestore security rules — role-based access.
//
// Roles come from the Firebase Auth custom claim `role`
// (set with `npm run set-roles`, see scripts/set-roles.mjs).
// Accounts without a role claim have NO access.
//
//   admin   → full read/write (no delete), 24/7
//   boss    → read-only oversight, 24/7
//   staff   → create & edit orders, payments, cancel, production
//   cashier → payment/deposit/price fields + production status
//   factory → production status fields only
//
// Every order write carries a change-history entry (who, when, what)
// and money collected is recorded in /payments. Both are append-only
// and readable by admin only.
//
// Non-admin/boss roles are also restricted to shop working hours
// (07:00–22:00 Asia/Beirut), enforced server-side here.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ──────────────────────────────────────
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }
    function isRole(r) { return role() == r; }
    function hasAnyRole() {
      return role() in ['admin', 'boss', 'staff', 'cashier', 'factory'];
    }

    // ── Working hours (07:00–22:00 Asia/Beirut) ───────────────
    // Lebanon is UTC+2, or UTC+3 during DST (last Sunday of March →
    // last Sunday of October). Transitions happen at local midnight,
    // which is outside working hours, so date-level precision is enough.
    // dayOfWeek(): Monday = 1 … Sunday = 7, so (dayOfWeek % 7) = days
    // since the most recent Sunday.
    function onOrAfterLastSunday(t) {
      return t.day() - (t.dayOfWeek() % 7) >= 25;
    }
    function isBeirutDst(t) {
      return (t.month() > 3 && t.month() < 10)
        || (t.month() == 3 && onOrAfterLastSunday(t))
        || (t.month() == 10 && !onOrAfterLastSunday(t));
    }
    function beirutHour() {
      return (request.time.hours() + (isBeirutDst(request.time) ? 3 : 2)) % 24;
    }
    function inWorkingHours() {
      return isRole('admin') || isRole('boss')
        || (beirutHour() >= 7 && beirutHour() < 22);
    }

    // ── Capabilities ──────────────────────────────────────────
    function canRead() { return hasAnyRole() && inWorkingHours(); }
    function canCreateOrders() {
      return (isRole('admin') || isRole('staff')) && inWorkingHours();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyChanges(allowed) {
      return changedKeys().hasOnly(allowed);
    }

    function validProductionStatus() {
      return !('productionStatus' in request.resource.data)
        || request.resource.data.productionStatus in ['received', 'in_progress', 'ready', 'delivered'];
    }

    // Bookkeeping fields written by the client on every update / sync.
    // (Listed literally inside each allow-list below; rules have no list concat.)

    // ── Change history (audit trail) ───────────────────────────
    // Every order create/update must, in the same batch, add a history
    // entry orders/{id}/history/{lastChangeId}. The entry records who
    // and when (server time) and must list every top-level field the
    // write changed. History can never be edited or deleted.
    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }
    function historyPath(orderId, changeId) {
      return /databases/$(database)/documents/orders/$(orderId)/history/$(changeId);
    }
    function newChangeId() {
      return request.resource.data.get('lastChangeId', '');
    }
    function createRecorded(orderId) {
      return newChangeId() is string && newChangeId() != ''
        && existsAfter(historyPath(orderId, newChangeId()));
    }
    function updateRecorded(orderId) {
      return newChangeId() is string && newChangeId() != ''
        && newChangeId() != resource.data.get('lastChangeId', '')
        && existsAfter(historyPath(orderId, newChangeId()));
    }

    // ── Orders ────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if canRead();

      allow create: if canCreateOrders()
        && orderId.matches('^CAKE-[0-9]+$')
        && request.resource.data.id == orderId
        && request.resource.data.header is map
        && validProductionStatus()
        && createRecorded(orderId);

      allow update: if inWorkingHours()
        && validProductionStatus()
        && request.resource.data.id == resource.data.id
        && updateRecorded(orderId)
        && (
          isRole('admin')
          || (isRole('staff')
              && !changedKeys().hasAny(['id', 'createdAt', 'customerVisitId']))
          || (isRole('cashier') && onlyChanges([
                'isPaid', 'paidAt', 'paidBy',
                'depositCollected', 'depositCollectedAt', 'depositCollectedBy',
                'depositPayment', 'finalPayment',
                'footer',
                'productionStatus', 'productionStatusUpdatedAt', 'productionStatusUpdatedBy',
                'updatedAt', 'syncedAt', 'savedAt', 'lastChangeId']))
          || (isRole('factory') && onlyChanges([
                'productionStatus', 'productionStatusUpdatedAt', 'productionStatusUpdatedBy',
                'updatedAt', 'syncedAt', 'savedAt', 'lastChangeId']))
        );

      // Deletion is never allowed (business audit safety).
      allow delete: if false;

      match /history/{changeId} {
        allow read: if isRole('admin');
        allow create: if hasAnyRole() && !isRole('boss') && inWorkingHours()
          && request.resource.data.keys().hasOnly(
               ['action', 'fields', 'changes', 'uid', 'by', 'role', 'at', 'clientAt', 'day'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == role()
          && request.resource.data.at == request.time
          && request.resource.data.fields is list
          && request.resource.data.changes is list
          && request.resource.data.action is string
          && existsAfter(orderPath(orderId))
          && getAfter(orderPath(orderId)).data.get('lastChangeId', '') == changeId
          && (
            !exists(orderPath(orderId))
            || getAfter(orderPath(orderId)).data.diff(get(orderPath(orderId)).data)
                 .affectedKeys().hasOnly(request.resource.data.fields.concat(['lastChangeId']))
          );
        allow update, delete: if false;
      }
    }

    // Admin report: query history across all orders.
    match /{path=**}/history/{changeId} {
      allow read: if isRole('admin');
    }

    // ── Payments ──────────────────────────────────────────────
    // One document per amount collected (or reversed), written in the
    // same batch as the order change it belongs to. Amounts may be in
    // USD, LBP or both. Never edited or deleted; a reversal is a new
    // 'void' entry with negative amounts.
    match /payments/{paymentId} {
      allow read: if isRole('admin');
      allow create: if (isRole('admin') || isRole('cashier') || isRole('staff'))
        && inWorkingHours()
        && request.resource.data.keys().hasOnly(
             ['orderId', 'changeId', 'kind', 'usd', 'lbp', 'uid', 'by', 'at', 'clientAt', 'day', 'customerName'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.usd is number
        && request.resource.data.lbp is number
        && (
          (request.resource.data.kind in ['deposit', 'final']
            && request.resource.data.usd >= 0 && request.resource.data.lbp >= 0
            && request.resource.data.usd + request.resource.data.lbp > 0)
          || (request.resource.data.kind == 'void'
            && request.resource.data.usd <= 0 && request.resource.data.lbp <= 0)
        )
        && existsAfter(orderPath(request.resource.data.orderId))
        && getAfter(orderPath(request.resource.data.orderId)).data.get('lastChangeId', '')
             == request.resource.data.changeId;
      allow update, delete: if false;
    }

    // ── Order serial counter ──────────────────────────────────
    // May only be created once, and afterwards only incremented by 1.
    match /metadata/orderCounter {
      allow read: if canCreateOrders();
      allow create: if canCreateOrders()
        && request.resource.data.keys().hasOnly(['serial'])
        && request.resource.data.serial is int
        && request.resource.data.serial >= 0;
      allow update: if canCreateOrders()
        && request.resource.data.keys().hasOnly(['serial'])
        && request.resource.data.serial == resource.data.serial + 1;
      allow delete: if false;
    }

    // Everything else is closed by default.
  }
}
